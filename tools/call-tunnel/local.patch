+/// Local patch: ask macOS for time-constraint (real-time) scheduling for the calling thread: a 10 ms period
+/// with up to 2 ms of work per period. No privileges needed. Logs and carries on if it is refused.
+#[cfg(target_os = "macos")]
+fn promote_to_realtime() {
+    #[repr(C)]
+    struct MachTimebaseInfo {
+        numer: u32,
+        denom: u32,
+    }
+    #[repr(C)]
+    struct TimeConstraintPolicy {
+        period: u32,
+        computation: u32,
+        constraint: u32,
+        preemptible: i32,
+    }
+    unsafe extern "C" {
+        fn mach_timebase_info(info: *mut MachTimebaseInfo) -> i32;
+        fn mach_thread_self() -> u32;
+        fn thread_policy_set(thread: u32, flavor: u32, policy_info: *mut TimeConstraintPolicy, count: u32) -> i32;
+    }
+    const THREAD_TIME_CONSTRAINT_POLICY: u32 = 2;
+    const THREAD_TIME_CONSTRAINT_POLICY_COUNT: u32 = 4;
+
+    let mut timebase = MachTimebaseInfo { numer: 0, denom: 0 };
+    // SAFETY: plain Mach calls with valid pointers to stack values that outlive the calls.
+    let rc = unsafe {
+        if mach_timebase_info(&mut timebase) != 0 || timebase.numer == 0 {
+            -1
+        } else {
+            let ticks = |ns: u64| (ns * u64::from(timebase.denom) / u64::from(timebase.numer)) as u32;
+            let mut policy = TimeConstraintPolicy {
+                period: ticks(WINDOW_MS * 1_000_000),
+                computation: ticks(2_000_000),
+                constraint: ticks(WINDOW_MS * 1_000_000),
+                preemptible: 1,
+            };
+            thread_policy_set(
+                mach_thread_self(),
+                THREAD_TIME_CONSTRAINT_POLICY,
+                &mut policy,
+                THREAD_TIME_CONSTRAINT_POLICY_COUNT,
+            )
+        }
+    };
+    if rc == 0 {
+        info!("pipe audio: clock thread is real-time");
+    } else {
+        warn!("pipe audio: real-time scheduling refused ({}); timing may suffer", rc);
+    }
+}
+
+#[cfg(not(target_os = "macos"))]
+fn promote_to_realtime() {}
